# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
# Check https://ai.google.dev/gemini-api/docs/models for current model codes.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used to sign the session cookie that carries flash messages. Any long random string works.
SECRET_KEY=replace-with-a-long-random-string
# 1 turns on Flask debug mode for local development. Leave it out or set 0 anywhere else.
FLASK_DEBUG=1
